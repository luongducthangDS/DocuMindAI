# DocuMind AI - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# LLM Provider — chỉ Gemini (embedding + sinh câu trả lời).
# Hết mọi cặp (key, model) thì rơi về trích nguyên văn nguồn, không gọi nhà cung cấp nào khác.
# Nên khai cả 3 key ở 3 project khác nhau để cộng dồn quota.
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=documind-ai

# Hugging Face
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vector store provider: "chroma" (mặc định, local) hoặc "qdrant" (Qdrant Cloud).
# Đổi provider chỉ cần đổi biến này, không sửa code (xem src/rag/vector_backend.py).
VECTOR_STORE_PROVIDER=chroma

# ChromaDB
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=documind_legal

# Qdrant Cloud (chỉ cần khi VECTOR_STORE_PROVIDER=qdrant)
# Tạo cluster free tại https://cloud.qdrant.io, rồi:
#   python scripts/migrate_chroma_to_qdrant.py --verify
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documind_legal

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080
ENVIRONMENT=development
# ALLOWED_ORIGINS: khi deploy tách domain (Vercel frontend + Render backend),
# thêm domain Vercel production vào đây, vd:
# ALLOWED_ORIGINS=http://localhost:5174,https://documind-ai.vercel.app
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Model Selection — chỉ Gemini; hỏng hết thì trích nguyên văn nguồn (không LLM).
# Gemini free tier RPD/RPM: 3.1-flash-lite=500/15, 3.5-flash-lite=500/15, 2.5-flash-lite=20/10.
# Tránh gemini-2.0-* / 1.5-* / *-pro (không có quota trên key free).
GEMINI_GENERATION_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_JUDGE_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Doi model => phai chay: python scripts/reembed_corpus.py --yes
# (collection mang nhan model; lech nhan se bao loi thay vi tra ket qua sai)
EMBEDDING_MODEL=gemini-embedding-001
INITIALIZE_RAG_ON_STARTUP=false
ENABLE_RERANKER=false

# Storage
DATA_DIR=./data
REPORTS_DIR=./reports
LOGS_DIR=./logs
SQLITE_DB=./data/documind.db

# Ingestion
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=64
